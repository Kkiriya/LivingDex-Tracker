generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// authenticated through clerk
model User {
  userId      Int         @id @default(autoincrement()) @map("user_id")
  clerkId     String      @unique @map("clerk_id")
  username    String
  email       String      @unique
  livingDexes LivingDex[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("users")
}

// pokemon types
model Type {
  typeId Int    @id @map("type_id")
  name   String @unique

  pokemonTypes PokemonType[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("types")
}

// A whole pokedex with all of its pokemons in order
model Pokedex {
  dexId Int    @id @map("dex_id")
  name  String

  pokemonEntries PokedexPokemon[]
  livingDexes    LivingDex[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("pokedex")
}

// Contains all the pokemons
model Pokemon {
  pokeId Int    @id @map("poke_id")
  name   String

  types            PokemonType[]
  pokedexEntries   PokedexPokemon[]
  livingDexEntries LivingDexPokemon[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("pokemon")
}

// many-to-many relationship between pokemon and types
model PokemonType {
  pokeId Int @map("poke_id")
  typeId Int @map("type_id")
  slot   Int

  pokemon Pokemon @relation(fields: [pokeId], references: [pokeId])
  type    Type    @relation(fields: [typeId], references: [typeId])

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@id([pokeId, typeId])
  @@unique([pokeId, slot])
  @@map("pokemon_types")
}

// links each pokemon the a specific dex with the correct dex order
model PokedexPokemon {
  dexId       Int @map("dex_id")
  pokeId      Int @map("poke_id")
  entryNumber Int @map("entry_number")

  pokedex Pokedex @relation(fields: [dexId], references: [dexId])
  pokemon Pokemon @relation(fields: [pokeId], references: [pokeId])

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@id([dexId, pokeId])
  @@unique([dexId, entryNumber])
  @@map("pokedex_pokemons")
}

model LivingDex {
  livingDexId Int     @id @default(autoincrement()) @map("living_dex_id")
  dexId       Int     @map("dex_id")
  userId      Int     @map("user_id")
  name        String
  description String? @map("desc")

  pokedex Pokedex            @relation(fields: [dexId], references: [dexId])
  user    User               @relation(fields: [userId], references: [userId])
  pokemon LivingDexPokemon[]

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("living_dex")
}

// A pokemon that is part of a living dex
model LivingDexPokemon {
  livingDexId Int     @map("living_dex_id")
  pokeId      Int     @map("poke_id")
  seen        Boolean @default(false)
  caught      Boolean @default(false)
  shiny       Boolean @default(false)

  livingDex LivingDex @relation(fields: [livingDexId], references: [livingDexId], onDelete: Cascade)
  pokemon   Pokemon   @relation(fields: [pokeId], references: [pokeId])

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@id([livingDexId, pokeId])
  @@map("living_dex_pokemon")
}
